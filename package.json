{
  "name": "wildpi-agent-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run spec:bundle && vitest run",
    "spec:bundle": "node scripts/bundle-spec.mjs",
    "spec:check": "node scripts/check-spec.mjs",
    "spec:update": "node scripts/check-spec.mjs --update && npm run api:generate",
    "api:generate": "node scripts/gen-api-md.mjs",
    "api:check": "node scripts/gen-api-md.mjs --check",
    "plugin:check": "node scripts/check-plugin.mjs",
    "evals:check": "node scripts/check-evals.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
